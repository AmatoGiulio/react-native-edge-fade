+  /**
+   * API 33+ experimental spatially-variable blur.
+   *
+   * The blur radius is evaluated continuously from the fade curve instead of
+   * quantized into 3 Gaussian levels. Each active edge costs one half-resolution
+   * RenderNode + one 9-tap RuntimeShader pass + one composite.
+   *
+   * Returns false if RuntimeShader creation/uniform upload fails, so drawBlur()
+   * can fall back to the production 3-band backend without double-drawing.
+   */
+  @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+  private fun drawBlurVariableAgsl(canvas: Canvas, w: Float, h: Float): Boolean {
+    val content = (blurNode ?: RenderNode("EdgeFadeBlur").also { blurNode = it })
+    content.setPosition(0, 0, width, height)
+    val rc = content.beginRecording()
+    try {
+      background?.draw(rc)
+      super.dispatchDraw(rc)
+    } finally {
+      content.endRecording()
+    }
+
+    // Validate/build all active edge shaders before drawing anything. If one
+    // edge fails we can still cleanly fall back to the production renderer.
+    if (fadeTop > 0f && !prepareVariableEdge(EDGE_TOP, content, curveTop, fadeTop,
+        0f, 0f, w, fadeTop, 0f, fadeTop, 0f, 0f)) return false
+    if (fadeBottom > 0f && !prepareVariableEdge(EDGE_BOTTOM, content, curveBottom, fadeBottom,
+        0f, h - fadeBottom, w, h, 0f, h - fadeBottom, 0f, h)) return false
+    if (fadeLeft > 0f && !prepareVariableEdge(EDGE_LEFT, content, curveLeft, fadeLeft,
+        0f, 0f, fadeLeft, h, fadeLeft, 0f, 0f, 0f)) return false
+    if (fadeRight > 0f && !prepareVariableEdge(EDGE_RIGHT, content, curveRight, fadeRight,
+        w - fadeRight, 0f, w, h, w - fadeRight, 0f, w, 0f)) return false
+
+    if (hasWebViewDescendant()) {
+      content.setUseCompositingLayer(true, null)
+      canvas.drawRenderNode(content)
+    } else {
+      content.setUseCompositingLayer(false, null)
+      super.dispatchDraw(canvas)
+    }
+
+    if (fadeTop > 0f) drawPreparedVariableEdge(canvas, EDGE_TOP, fadeTop,
+      0f, 0f, w, fadeTop)
+    if (fadeBottom > 0f) drawPreparedVariableEdge(canvas, EDGE_BOTTOM, fadeBottom,
+      0f, h - fadeBottom, w, h)
+    if (fadeLeft > 0f) drawPreparedVariableEdge(canvas, EDGE_LEFT, fadeLeft,
+      0f, 0f, fadeLeft, h)
+    if (fadeRight > 0f) drawPreparedVariableEdge(canvas, EDGE_RIGHT, fadeRight,
+      w - fadeRight, 0f, w, h)
+
+    overlayColor?.let { drawFrostVeil(canvas, w, h, it) }
+    return true
+  }
