+  @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+  private fun prepareVariableEdge(
+    edge: Int, content: RenderNode, curve: String, size: Float,
+    bandLeft: Float, bandTop: Float, bandRight: Float, bandBottom: Float,
+    gx0: Float, gy0: Float, gx1: Float, gy1: Float,
+  ): Boolean {
+    val ds = VARIABLE_BLUR_DOWNSCALE
+    val pad = ceil(blurRadius)
+    val vw = width.toFloat(); val vh = height.toFloat()
+    val nLeft = (bandLeft - pad).coerceAtLeast(0f)
+    val nTop = (bandTop - pad).coerceAtLeast(0f)
+    val nRight = (bandRight + pad).coerceAtMost(vw)
+    val nBottom = (bandBottom + pad).coerceAtMost(vh)
+    val nodeW = ceil((nRight - nLeft) * ds).roundToInt().coerceAtLeast(1)
+    val nodeH = ceil((nBottom - nTop) * ds).roundToInt().coerceAtLeast(1)
+
+    val node = variableBlurNodes[edge]
+      ?: RenderNode("EdgeFadeVariableBlur_$edge").also { variableBlurNodes[edge] = it }
+    node.setPosition(0, 0, nodeW, nodeH)
+    val rc = node.beginRecording()
+    try {
+      rc.scale(ds, ds)
+      rc.translate(-nLeft, -nTop)
+      rc.drawRenderNode(content)
+    } finally {
+      node.endRecording()
+    }
+
+    val variable = variableBlurShaders[edge] ?: runCatching { EdgeFadeVariableBlurShader() }
+      .onFailure { logVariableBlurFallbackOnce("RuntimeShader compile failed", it) }
+      .getOrNull()
+      ?.also { variableBlurShaders[edge] = it }
+      ?: return false
+
+    val ok = variable.update(
+      curve = curve,
+      nodeWidth = nodeW.toFloat(), nodeHeight = nodeH.toFloat(),
+      x0 = (gx0 - nLeft) * ds, y0 = (gy0 - nTop) * ds,
+      x1 = (gx1 - nLeft) * ds, y1 = (gy1 - nTop) * ds,
+      maxRadius = blurRadius * ds,
+      frostProgression = frostProgression,
+      frostSaturation = frostSaturation,
+      frostLift = frostLift,
+    )
+    if (!ok) {
+      logVariableBlurFallbackOnce("RuntimeShader uniform upload failed", null)
+      return false
+    }
+    node.setRenderEffect(variable.renderEffect())
+    variableBlurRects[edge].set(nLeft, nTop, nRight, nBottom)
+    return true
+  }
+
+  @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+  private fun drawPreparedVariableEdge(
+    canvas: Canvas, edge: Int,
+    bandLeft: Float, bandTop: Float, bandRight: Float, bandBottom: Float,
+  ) {
+    val node = variableBlurNodes[edge] ?: return
+    val rect = variableBlurRects[edge]
+    val ds = VARIABLE_BLUR_DOWNSCALE
+    val sc = canvas.save()
+    canvas.clipRect(bandLeft, bandTop, bandRight, bandBottom)
+    canvas.translate(rect.left, rect.top)
+    canvas.scale(1f / ds, 1f / ds)
+    canvas.drawRenderNode(node)
+    canvas.restoreToCount(sc)
+  }
