{
  "extends": "../tsconfig",
  "compilerOptions": {
    // Drop the strict-api customConditions used by the library so example
    // code can use the standard react-native typings.
    "customConditions": [],
    // Feature-based source layout under src/, addressed with the `@/` alias.
    // Paths resolve relative to this tsconfig (no baseUrl needed on TS 5+);
    // Metro resolves the same tsconfig paths automatically on Expo SDK 49+.
    "paths": {
      "@/*": ["./src/*"],
      "react-native-edge-fade": ["../src/index"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "android", "ios", ".expo"]
}
